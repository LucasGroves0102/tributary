    {
      "type": "stat",
      "title": "Published → queryable p50",
      "description": "Median time from SEC acceptance (live feed) to the filing's sections or facts being queryable, over tracked filings accepted in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tributary"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY queryable_lag_s) AS p50\nFROM ops.filing_latency WHERE $__timeFilter(accepted_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
