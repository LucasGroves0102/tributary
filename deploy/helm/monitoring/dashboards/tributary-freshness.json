    {
      "type": "timeseries",
      "title": "Published → bronze, all live filings",
      "description": "Poller → Kafka → bronze-loader, per acceptance-time bucket.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tributary"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(accepted_at, $__interval),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY bronze_lag_s) AS p50,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY bronze_lag_s) AS p95,\n       max(bronze_lag_s) AS max\nFROM ops.filing_latency\nWHERE $__timeFilter(accepted_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Published → queryable, per tracked filing",
      "description": "One point per filing at its acceptance time. Sections arrive via doc-fetcher → parser within minutes; facts wait for the nightly financials job and the companyfacts API.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tributary"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT accepted_at AS time,\n       sections_lag_s AS \"sections (filings tier)\",\n       facts_lag_s AS \"facts (financials tier)\"\nFROM ops.filing_latency\nWHERE $__timeFilter(accepted_at) AND company_id IS NOT NULL\n  AND form IN ('10-K', '10-Q', '8-K')\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 10,
      "gridPos": {
