    {
      "type": "table",
      "title": "Tracked filings: time from acceptance to each stage",
      "description": "Live-feed 10-K / 10-Q / 8-K filings of tracked companies. Empty cells: stage not reached (facts only exist for 10-K / 10-Q). A re-parse resets the sections time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tributary"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT accepted_at, company, form, accession_no,\n       bronze_lag_s AS bronze, extract(epoch FROM document_at - accepted_at) AS document,\n       sections_lag_s AS sections, facts_lag_s AS facts, queryable_lag_s AS queryable\nFROM ops.filing_latency\nWHERE $__timeFilter(accepted_at) AND company_id IS NOT NULL\n  AND form IN ('10-K', '10-Q', '8-K')\nORDER BY accepted_at DESC\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "bronze|document|sections|facts|queryable"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "accepted_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      }
    },
