            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS waiting\nFROM ops.filing_latency\nWHERE $__timeFilter(accepted_at) AND company_id IS NOT NULL\n  AND form IN ('10-K', '10-Q', '8-K') AND queryable_at IS NULL\n  AND accepted_at < now() - interval '1 hour'"
