      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tributary"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT live_coverage_pct AS coverage\nFROM ops.filings_daily_coverage\nWHERE day < (now() AT TIME ZONE 'America/New_York')::date\nORDER BY day DESC LIMIT 1"
        }
      ],
