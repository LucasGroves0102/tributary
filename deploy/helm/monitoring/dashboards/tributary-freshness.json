    {
      "type": "stat",
      "title": "Live coverage, last full day",
      "description": "Share of the last complete EDGAR day's filings the live poller caught before the daily-index backfill.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tributary"
