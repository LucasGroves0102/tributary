[Unit]
Description=Weekly Postgres restore test

[Timer]
# Sunday, after that day's full backup (pg-backup.timer at 05:00 New York, FULL_WEEKDAY=7) has
# had six hours to finish. A backup still running is skipped (only finished directories count),
# and the previous full backup is tested instead.
OnCalendar=Sun *-*-* 11:00:00 America/New_York
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
