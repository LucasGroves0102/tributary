[Unit]
Description=Nightly Postgres logical backup

[Timer]
# After the 02:00-04:00 New York CronJobs (backfill, companies, financials) and alongside the bulk
# loads that start at 05:00 (financials-bulk) and 05:30 (submissions): each dump is one consistent
# snapshot, so it holds what those had committed when it began and the next night's has the rest.
OnCalendar=*-*-* 05:00:00 America/New_York
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
