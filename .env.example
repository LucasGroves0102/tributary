# SEC requires a declared User-Agent: "<app name> <contact email>"
SEC_USER_AGENT="Tributary your-email@example.com"

POSTGRES_USER=tributary
POSTGRES_PASSWORD=tributary
POSTGRES_DB=tributary
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tributary:tributary@localhost:5433/tributary
APP_DATABASE_URL=postgresql://tributary:tributary@localhost:5433/app
FGA_API_URL=http://localhost:8081
QUERY_API_JWT_SECRET=change-me-to-at-least-32-random-bytes

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Week 2
ANTHROPIC_API_KEY=
# Agent model: claude-haiku-5-5 (cheapest), claude-sonnet-5-5, claude-opus-5-5
AGENT_MODEL=claude-haiku-5-5
QUERY_API_URL=http://localhost:8000

# Optional: "Sign in with GitHub" (services/query-api README, "GitHub sign-in"). Both id and
# secret of a GitHub OAuth app, or the routes stay off. Local callback URL:
# http://localhost:5173/api/query/v1/auth/github/callback (the Vite dev server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Optional: "Connect your data" (services/query-api README). The master key that encrypts
# users' own market-data API keys: k1:<base64 of 32 random bytes>; empty = feature off.
# Generate one: python3 -c 'import base64,secrets;print("k1:"+base64.b64encode(secrets.token_bytes(32)).decode())'
DATA_CONNECTIONS_KEY=
